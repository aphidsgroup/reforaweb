{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "env": {
    "DATABASE_URL": "@refora-database-url",
    "AUTH_SECRET": "@refora-auth-secret",
    "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME": "dautrievu",
    "CLOUDINARY_API_KEY": "@refora-cloudinary-api-key",
    "CLOUDINARY_API_SECRET": "@refora-cloudinary-api-secret",
    "RAZORPAY_KEY_ID": "@refora-razorpay-key-id",
    "RAZORPAY_KEY_SECRET": "@refora-razorpay-key-secret",
